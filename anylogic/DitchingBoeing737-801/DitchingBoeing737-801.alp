				<Event>
					<Id>1788011354224</Id>
					<Name><![CDATA[radar]]></Name>
					<X>330</X><Y>-140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1788011354222</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1788076800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[30]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[30]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[int quietos = 0;
for ( Pasajero q : activos ) if ( q.getSpeed() < 0.05 ) quietos++;
int sentandose = Sentado.size() + SentadoDer.size();
traceln( "evac=%.0fs  sentados=%d  caminando=%d  quietos=%d  evacuados=%d  TOTAL=%d",
         time() - tAmerizaje, sentandose, activos.size(), quietos, evacuados,
         sentandose + activos.size() + evacuados );]]></Action>
				</Event>
				<Event>
					<Id>1788028432101</Id>
					<Name><![CDATA[recalculo]]></Name>
					<X>330</X><Y>-170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1788028432099</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1788076800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[10]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[10]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[for ( Pasajero q : new java.util.ArrayList<Pasajero>( activos ) ) {
    if ( q.getSpeed() >= 0.15 ) continue;
    int nueva = elegirSalida( q, true );
    if ( nueva >= 0 && nueva != q.salidaIdx ) {
        enCamino[ q.salidaIdx ]--;
        q.salidaIdx = nueva;
        enCamino[ nueva ]++;
    }
    if ( Camina.contains( q ) ) Camina.cancel( q );
}]]></Action>
				</Event>
				<Event>
					<Id>1788030406665</Id>
					<Name><![CDATA[amerizaje]]></Name>
					<X>330</X><Y>-110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1788030406663</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1788076800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if ( tAmerizaje >= 0 ) return;
if ( Sentado.size() + SentadoDer.size() < totalPax ) return;
tAmerizaje = time();
for ( Pasajero q : new java.util.ArrayList<Pasajero>( Sentado.getPeds() ) ) Sentado.activate( q );
for ( Pasajero q : new java.util.ArrayList<Pasajero>( SentadoDer.getPeds() ) ) SentadoDer.activate( q );
traceln( ">>> AMERIZAJE en t=" + tAmerizaje );]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788006886992</Id>
					<Name><![CDATA[posSalidaX]]></Name>
					<X>460</X><Y>-130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[return salidas[ i ].getX();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788006944599</Id>
					<Name><![CDATA[posSalidaY]]></Name>
					<X>460</X><Y>-100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[return salidas[ i ].getY() + 9;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788008550554</Id>
					<Name><![CDATA[distanciaSalida]]></Name>
					<X>460</X><Y>-70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[return Math.abs( p.getY() - posSalidaY( i ) )
     + Math.abs( p.getX() - posSalidaX( i ) );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1788008599363</Id>
					<Name><![CDATA[elegirSalida]]></Name>
					<X>460</X><Y>-40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[sabeBloqueos]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[int mejor = -1;
double mejorCosto = Double.POSITIVE_INFINITY;

for ( int i = 0; i < salidas.length; i++ ) {
    if ( sabeBloqueos && !salidaActiva[ i ] ) continue;
    double costo = distanciaSalida( p, i ) + pesoCongestion * gentEnCamino( p, i );
    if ( costo < mejorCosto ) { mejorCosto = costo; mejor = i; }
}
return mejor;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1788028294597</Id>
					<Name><![CDATA[gentEnCamino]]></Name>
					<X>600</X><Y>-70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[double y0 = Math.min( p.getY(), posSalidaY( i ) );
double y1 = Math.max( p.getY(), posSalidaY( i ) );
int n = 0;
for ( Pasajero q : activos )
    if ( q != p && q.getY() >= y0 && q.getY() <= y1 ) n++;
return n;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788030955066</Id>
					<Name><![CDATA[configurarEscenario]]></Name>
					<X>600</X><Y>-100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[switch ( escenario ) {
    case 1:  salidaActiva = new boolean[]{ true,  true,  true,  true,  true,  true  }; break;
    case 2:  salidaActiva = new boolean[]{ true,  false, false, true,  true,  false }; break;
    case 3:  salidaActiva = new boolean[]{ false, false, true,  true,  true,  false }; break;
    case 4:  salidaActiva = new boolean[]{ true,  false, true,  false, true,  false }; break;
    default: salidaActiva = new boolean[]{ true,  true,  true,  true,  true,  true  };
}]]></Body>
				</Function>
			</Functions>
