		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1787743493622</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[salidas = new TargetLine[]{
    targetLine,      // 0 = 1L        puerta delantera izquierda
    targetLine1,     // 1 = 1R        puerta delantera derecha
    targetLine4,     // 2 = AlaFwdL   sobre el ala, delantera izquierda
    targetLine9,     // 3 = AlaFwdR   sobre el ala, delantera derecha
    targetLine3,     // 4 = AlaAftL   sobre el ala, trasera izquierda
    targetLine5      // 5 = AlaAftR   sobre el ala, trasera derecha
};

configurarEscenario();
enCamino     = new int[ 6 ];
porSalida    = new int[ 6 ];
tApertura    = new double[ 6 ];
tLibre       = new double[ 6 ];   // 0 = libre desde el inicio
java.util.Arrays.fill( tApertura, -1 );   // -1 = todavia nadie la empezo a abrir
tPrimeraSalida = new double[ 6 ];  java.util.Arrays.fill( tPrimeraSalida, -1 );
tUltimaSalida  = new double[ 6 ];  java.util.Arrays.fill( tUltimaSalida,  -1 );
tEvacuacionPax = -1;
tEvacuacionTotal = -1;
// menores de 8 anios: ocupan su asiento pero viajan en brazos de un adulto,
// asi que por cada menor hay un peaton menos (el adulto que lo carga cuenta por 2)
nBebes = 0;
for ( int i = 0; i < totalPax; i++ ) if ( randomTrue( 0.017 ) ) nBebes++;
int izq = 93, der = 93;
for ( int i = 0; i < nBebes; i++ ) { if ( randomTrue( 0.5 ) ) izq--; else der--; }
Nace.inject( izq );
NaceDer.inject( der );

// tripulacion: 2 azafatas delanteras, 2 traseras, 2 pilotos
NaceTripDel.inject( 2 );
NaceTripTras.inject( 2 );
NacePilotos.inject( 2 );

// linea de 90 s para el grafico de evacuacion acumulada (Integrante 4)
dsUmbral90.add( 90, 0 );
dsUmbral90.add( 90, totalPax + 6 );]]></StartupCode>
