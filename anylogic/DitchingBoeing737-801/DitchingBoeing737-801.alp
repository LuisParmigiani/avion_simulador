			<Events>
				<Event>
					<Id>1788011354224</Id>
					<Name><![CDATA[radar]]></Name>
					<X>330</X><Y>-140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1788011354222</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1788076800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[30]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[30]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[int quietos = 0;
for ( Pasajero q : activos ) if ( q.getSpeed() < 0.05 ) quietos++;
int sentandose = Sentado.size() + SentadoDer.size() + SentadoTrip.size();
traceln( "evac=%.0fs  sentados=%d  caminando=%d  quietos=%d  evacuados=%d  TOTAL=%d",
         time() - tAmerizaje, sentandose, activos.size(), quietos, evacuados,
         sentandose + activos.size() + evacuados );
// quedan pocos: mostrar donde esta cada uno, para diagnosticar trabas
if ( activos.size() <= 3 )
    for ( Pasajero q : activos )
        traceln( "   rezagado: salida=%s activa=%b abierta=%b  bloque=%s  x=%.0f y=%.0f  v=%.2f",
            nombreSalida( q.salidaIdx ), salidaActiva[ q.salidaIdx ], salidaAbierta( q.salidaIdx ),
            SalirFila.contains( q ) ? "SalirFila" : Pasillo.contains( q ) ? "Pasillo"
            : Camina.contains( q ) ? "Camina" : EsperaPuerta.contains( q ) ? "EsperaPuerta" : "otro",
            q.getX(), q.getY(), q.getSpeed() );]]></Action>
				</Event>
				<Event>
					<Id>1788028432101</Id>
					<Name><![CDATA[recalculo]]></Name>
					<X>330</X><Y>-170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1788028432099</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1788076800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[10]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[10]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[for ( Pasajero q : new java.util.ArrayList<Pasajero>( activos ) ) {
    // se metio en una fila que no es la de su salida (queda del otro lado de una pared
    // y no la puede alcanzar): que vuelva al pasillo y haga de nuevo las 3 etapas
    if ( Camina.contains( q ) ) {
        boolean enAsientos = q.getX() < 410 || q.getX() > 460;   // bien adentro de una fila, no apenas empujado
        boolean filaEquivocada = q.salidaIdx <= 1
            ? q.getY() > 352                                            // puertas delanteras: no tiene que estar en ninguna fila
            : Math.abs( q.getY() - posSalidaY( q.salidaIdx ) ) > 20;    // sobre el ala: solo en la fila de su salida
        if ( enAsientos && filaEquivocada ) { Camina.cancel( q ); continue; }
    }
    if ( q.getSpeed() >= 0.15 ) continue;
    if ( EsperaPuerta.contains( q ) ) continue;   // espera que abran su puerta, no es que este trabado
        if ( salidaActiva[ q.salidaIdx ] && distanciaSalida( q, q.salidaIdx ) < 2.0 * 43.9 ) continue;   // a menos de 2 m de su puerta (si sirve): ya esta llegando
    int nueva = elegirSalida( q, true );
    if ( nueva >= 0 && nueva != q.salidaIdx ) {
        // solo cambia de salida si la nueva es claramente mejor (20% menos de costo)
        // o si la suya esta bloqueada: evita que en una cola cambien de idea cada 10 s y se den vuelta
        double costoActual = distanciaSalida( q, q.salidaIdx ) + pesoCongestion * gentEnCamino( q, q.salidaIdx );
        double costoNueva  = distanciaSalida( q, nueva )       + pesoCongestion * gentEnCamino( q, nueva );
        if ( !salidaActiva[ q.salidaIdx ] || costoNueva < 0.8 * costoActual ) {
            enCamino[ q.salidaIdx ]--;
            q.salidaIdx = nueva;
            enCamino[ nueva ]++;
            // recien ahora se lo saca de su camino, para que vaya hacia la nueva salida
            if ( Camina.contains( q ) )  Camina.cancel( q );    // vuelve al pasillo
            if ( Pasillo.contains( q ) ) Pasillo.cancel( q );   // recalcula a que altura del pasillo ir
        }
    }
}]]></Action>
				</Event>
				<Event>
					<Id>1792000000001</Id>
					<Name><![CDATA[frenoValijas]]></Name>
					<X>330</X><Y>-200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1792000000002</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1788076800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[0.25]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// OBSTACULO DE PASILLO (seccion 4.2.2 del informe).
// Las 4 valijas caidas (agentes Valija, ubicadas al azar en nodoValijas) frenan a quien pasa:
// todo peaton a menos de "radio" del centro de una valija camina a "factor" de su velocidad
// normal y la recupera al alejarse. Radio y factor son supuestos propios del equipo.
if ( !hayObstaculo ) return;   // interruptor para medir el efecto de las valijas
double radio = 0.5;     // m al centro de la valija
double factor = 0.5;    // fraccion de la velocidad que conserva al pasarla
for ( Pasajero q : activos ) {
    double v = q.velocidadPreferida * factorIluminacion;
    for ( Valija b : valijas )
        if ( q.distanceTo( b, METER ) < radio ) { v *= factor; break; }
    if ( q.getComfortableSpeed() != v ) q.setComfortableSpeed( v );
}]]></Action>
				</Event>
				<Event>
					<Id>1788030406665</Id>
					<Name><![CDATA[amerizaje]]></Name>
					<X>330</X><Y>-110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1788030406663</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1788076800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if ( tAmerizaje >= 0 ) return;
if ( Sentado.size() + SentadoDer.size() < totalPax - nBebes ) return;
tAmerizaje = time();
// se eligen al azar los adultos que cargan a los menores
java.util.List<Pasajero> adultos = new java.util.ArrayList<Pasajero>();
for ( Pasajero q : Sentado.getPeds() )    if ( q.edad >= 18 && !q.esPMR ) adultos.add( q );
for ( Pasajero q : SentadoDer.getPeds() ) if ( q.edad >= 18 && !q.esPMR ) adultos.add( q );
java.util.Collections.shuffle( adultos, getDefaultRandomGenerator() );
for ( int i = 0; i < nBebes; i++ ) {
    Pasajero q = adultos.get( i );
    q.set_llevaMenor( true );
    q.configurarPerfil();   // aplica el x0.80 de velocidad
    q.setComfortableSpeed( q.velocidadPreferida * factorIluminacion );
}
traceln( "Menores en brazos: " + nBebes );

for ( Pasajero q : new java.util.ArrayList<Pasajero>( Sentado.getPeds() ) ) Sentado.activate( q );
for ( Pasajero q : new java.util.ArrayList<Pasajero>( SentadoDer.getPeds() ) ) SentadoDer.activate( q );
// las azafatas delanteras estan sentadas junto a las puertas tipo I:
// las abren desde su puesto, sin moverse, y despues siguen esperando
for ( int i = 0; i <= 1; i++ )
    if ( salidaActiva[ i ] ) tApertura[ i ] = time() + duracionApertura( i );

traceln( ">>> AMERIZAJE en t=" + tAmerizaje );]]></Action>
				</Event>
			</Events>
