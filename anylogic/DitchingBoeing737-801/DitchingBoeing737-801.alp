			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787874648870</Id>
					<Name><![CDATA[configurarPerfil]]></Name>
					<X>70</X><Y>-20</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ============ PERFIL SEGÚN ROL ============
if ( rol == RolPax.PASAJERO ) {

    // --- Velocidad base según edad/género (Bohannon 1997) ---
    double v;
    if ( esPMR ) {
        v = 0.60;
    } else if ( edad <= 12 ) {
        v = 0.90;                     // niño (8-12)
    } else if ( edad > 65 ) {
        v = 0.90;                     // mayor
    } else if ( edad <= 40 ) {
        v = esHombre ? 1.40 : 1.25;   // joven / adulto (incluye adolescentes 13+)
    } else {
        v = esHombre ? 1.25 : 1.15;   // adulto 41-65
    }
    velocidadPreferida = triangular( v - 0.20, v, v + 0.20 );

    // --- Si carga un bebé en brazos, se mueve más lento (supuesto propio) ---
    if ( llevaMenor ) {
        velocidadPreferida *= 0.80;
    }

    tiempoReaccion = triangular( 1, 2, 3 );
    demoraEquipaje = llevaEquipaje ? triangular( 2, 4, 8 ) : 0;
    diametro       = esPMR ? 0.55 : 0.4558;

} else {

    // --- Tripulación / pilotos: adultos sanos y entrenados ---
    edad          = roundToInt( uniform( 25, 60 ) );
    esPMR         = false;
    llevaEquipaje = false;
    llevaMenor  = false;
    velocidadPreferida = triangular( 1.25, 1.40, 1.55 );
    tiempoReaccion     = triangular( 0, 0.5, 1 );
    demoraEquipaje     = 0;
    diametro           = 0.4558;
}]]></Body>
				</Function>
			</Functions>


