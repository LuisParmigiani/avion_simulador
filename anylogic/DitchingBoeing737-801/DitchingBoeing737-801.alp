		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1787743493622">
			<Id>1793193935822</Id>
			<Name><![CDATA[Sensibilidad]]></Name>
			<AdditionalClassCode><![CDATA[// ================= Registro y estadistica (Integrante 4) =================
java.io.PrintWriter csvCorridas, csvAgentes;
boolean encabezadoListo;
static final int TMAX = 600;   // horizonte de la curva acumulada (s)
static final int K = 7;        // claves: escenario 1..5 o nBloqueadas 0..5
static final String[] SAL = { "1L", "1R", "AlaFwdL", "AlaFwdR", "AlaAftL", "AlaAftR" };
int[] nCorr, nCumple;
int paxTotal = 192;
java.util.List<java.util.List<Double>> tiempos;   // tEvacTotal (192 ocupantes) de cada corrida completa
double[][] curvaSum, paxSalidaSum, ultSum;
int[][] ultN;

void iniciar( String sufijo, boolean conAgentes ) {
    nCorr = new int[ K ];  nCumple = new int[ K ];
    curvaSum = new double[ K ][ TMAX + 1 ];
    paxSalidaSum = new double[ K ][ 6 ];
    ultSum = new double[ K ][ 6 ];  ultN = new int[ K ][ 6 ];
    tiempos = new java.util.ArrayList<java.util.List<Double>>();
    for ( int k = 0; k < K; k++ ) tiempos.add( new java.util.ArrayList<Double>() );
    encabezadoListo = false;
    try {
        csvCorridas = new java.io.PrintWriter( new java.io.FileWriter( "corridas_" + sufijo + ".csv" ) );
        csvAgentes = conAgentes
            ? new java.io.PrintWriter( new java.io.FileWriter( "agentes_" + sufijo + ".csv" ) ) : null;
            csvCorridas.println( "sep=;" );                       // <-- nuevo
        if ( csvAgentes != null ) csvAgentes.println( "sep=;" ); // <-- nuevo
    } catch ( java.io.IOException ex ) {
        throw new RuntimeException( "No se pudo crear el CSV (esta abierto en Excel?): " + ex );
    }
}

synchronized void registrar( Main m, int k, double pct ) {
    if ( !encabezadoListo ) {
        csvCorridas.println( "escenario;nBloqueadas;pctBloqueado;replica;" + m.encabezadoCorrida() );
        if ( csvAgentes != null )
            csvAgentes.println( "escenario;replica;rol;salida;tEvac;edad;esHombre;esPMR;llevaEquipaje;llevaMenor" );
        encabezadoListo = true;
    }
    int rep = ++nCorr[ k ];
    csvCorridas.println( m.escenario + ";" + m.nBloqueadas + ";" + m.num( pct ) + ";" + rep + ";" + m.filaCorrida() );
    csvCorridas.flush();
    if ( csvAgentes != null ) {
        for ( String f : m.registroAgentes ) csvAgentes.println( m.escenario + ";" + rep + ";" + f );
        csvAgentes.flush();
    }
    if ( m.tEvacuacionTotal < 0 ) return;   // incompleta: queda en el CSV, no entra en graficos
    paxTotal = m.totalPax + 6;              // ocupantes: pasajeros + tripulacion
    tiempos.get( k ).add( m.tEvacuacionTotal );
    if ( m.tEvacuacionTotal <= 90 ) nCumple[ k ]++;
    for ( int i = 0; i < 6; i++ ) {
        paxSalidaSum[ k ][ i ] += m.porSalida[ i ];
        if ( m.tUltimaSalida[ i ] >= 0 ) { ultSum[ k ][ i ] += m.rel( m.tUltimaSalida[ i ] ); ultN[ k ][ i ]++; }
    }
    int j = 0;   // tiemposEvac ya esta en orden cronologico
    for ( int s = 0; s <= TMAX; s++ ) {
        while ( j < m.tiemposEvac.size() && m.tiemposEvac.get( j ) <= s ) j++;
        curvaSum[ k ][ s ] += j;
    }
}

int nOk( int k ) { return tiempos.get( k ).size(); }

double media( int k ) {
    double s = 0;
    for ( double t : tiempos.get( k ) ) s += t;
    return nOk( k ) > 0 ? s / nOk( k ) : 0;
}

double desvio( int k ) {
    int n = nOk( k );
    if ( n < 2 ) return 0;
    double m = media( k ), s = 0;
    for ( double t : tiempos.get( k ) ) s += ( t - m ) * ( t - m );
    return Math.sqrt( s / ( n - 1 ) );
}

double tStudent( int gl ) {   // t(0.975; gl)
    double[] tab = { 12.706, 4.303, 3.182, 2.776, 2.571, 2.447, 2.365, 2.306, 2.262, 2.228,
                     2.201, 2.179, 2.160, 2.145, 2.131, 2.120, 2.110, 2.101, 2.093, 2.086,
                     2.080, 2.074, 2.069, 2.064, 2.060, 2.056, 2.052, 2.048, 2.045, 2.042 };
    return gl <= 30 ? tab[ gl - 1 ] : 1.96;
}

double ic95( int k ) {   // semiancho del IC 95% de la media
    int n = nOk( k );
    return n < 2 ? 0 : tStudent( n - 1 ) * desvio( k ) / Math.sqrt( n );
}

double percentil( int k, double p ) {   // mismo criterio que PERCENTIL.INC de Excel
    java.util.List<Double> v = new java.util.ArrayList<Double>( tiempos.get( k ) );
    if ( v.isEmpty() ) return 0;
    java.util.Collections.sort( v );
    double pos = p * ( v.size() - 1 );
    int i = (int) Math.floor( pos );
    if ( i + 1 >= v.size() ) return v.get( v.size() - 1 );
    return v.get( i ) + ( pos - i ) * ( v.get( i + 1 ) - v.get( i ) );
}

double promSalida( int k, int i ) { return nOk( k ) > 0 ? paxSalidaSum[ k ][ i ] / nOk( k ) : 0; }
double promUltima( int k, int i ) { return ultN[ k ][ i ] > 0 ? ultSum[ k ][ i ] / ultN[ k ][ i ] : -1; }
double curvaProm( int k, int s ) { return nOk( k ) > 0 ? curvaSum[ k ][ s ] / nOk( k ) : 0; }

int salidaMayorThroughput( int k ) {
    int b = 0;
    for ( int i = 1; i < 6; i++ ) if ( promSalida( k, i ) > promSalida( k, b ) ) b = i;
    return b;
}

int salidaMayorSaturacion( int k ) {   // la que en promedio despacha a su ultimo pasajero mas tarde
    int b = 0;
    for ( int i = 1; i < 6; i++ ) if ( promUltima( k, i ) > promUltima( k, b ) ) b = i;
    return b;
}

String resumenTexto( int desde, int hasta ) {
    StringBuilder sb = new StringBuilder();
    for ( int k = desde; k <= hasta; k++ ) {
        if ( nCorr == null || nCorr[ k ] == 0 ) continue;
        sb.append( String.format( "[%d] media %.1f s +/- %.1f  |  P95 %.1f s  |  cumplen 90 s: %d/%d  |  "
                + "incompletas: %d  |  mas usada: %s  |  satura: %s%n",
            k, media( k ), ic95( k ), percentil( k, 0.95 ), nCumple[ k ], nOk( k ),
            nCorr[ k ] - nOk( k ), SAL[ salidaMayorThroughput( k ) ], SAL[ salidaMayorSaturacion( k ) ] ) );
    }
    return sb.length() == 0 ? "Sin corridas todavia" : sb.toString();
}

void escribirResumen( String sufijo, int desde, int hasta ) {
    try ( java.io.PrintWriter w = new java.io.PrintWriter( new java.io.FileWriter( "resumen_" + sufijo + ".csv" ) ) ) {
        w.println( "sep=;" );
        w.println( "clave;corridas;completas;media;desvio;ic95_inf;ic95_sup;p95;min;max;"
                 + "pct_cumple_90;salida_mayor_throughput;salida_mayor_saturacion" );
        java.util.Locale ar = java.util.Locale.US;
        for ( int k = desde; k <= hasta; k++ ) {
            if ( nCorr[ k ] == 0 ) continue;
            double m = media( k ), h = ic95( k );
            w.println( String.format( ar, "%d;%d;%d;%.2f;%.2f;%.2f;%.2f;%.2f;%.2f;%.2f;%.1f;%s;%s",
                k, nCorr[ k ], nOk( k ), m, desvio( k ), m - h, m + h,
                percentil( k, 0.95 ), percentil( k, 0 ), percentil( k, 1 ),
                nOk( k ) > 0 ? 100.0 * nCumple[ k ] / nOk( k ) : 0,
                SAL[ salidaMayorThroughput( k ) ], SAL[ salidaMayorSaturacion( k ) ] ) );
        }
    } catch ( java.io.IOException ex ) {
        throw new RuntimeException( "No se pudo escribir el resumen: " + ex );
    }
}

void cerrar() {
    if ( csvCorridas != null ) csvCorridas.close();
    if ( csvAgentes != null ) csvAgentes.close();
}

// ---------------- utilidades de dibujo sobre un Plot ----------------
static final java.awt.Color TINTA = new java.awt.Color( 40, 40, 40 );
static final java.awt.Color ROJO = new java.awt.Color( 227, 73, 72 );
static final String[] NOMBRE_ESC = { "", "1 Baseline", "2 50% alternado", "3 50% centro libre", "4 Asimetrico" };

// color del escenario e; claro = 0 da el color pleno, claro = 0.65 lo aclara (para cajas)
java.awt.Color colorEsc( int e, double claro ) {
    int[][] c = { { 42, 120, 214 }, { 235, 104, 52 }, { 27, 175, 122 }, { 237, 161, 0 } };
    int[] x = c[ ( e - 1 ) % 4 ];
    return new java.awt.Color( (int) ( x[ 0 ] + ( 255 - x[ 0 ] ) * claro ),
                               (int) ( x[ 1 ] + ( 255 - x[ 1 ] ) * claro ),
                               (int) ( x[ 2 ] + ( 255 - x[ 2 ] ) * claro ) );
}

// segmento recto de (x1,y1) a (x2,y2)
void linea( Plot p, double x1, double y1, double x2, double y2, java.awt.Color c, double ancho, String titulo ) {
    DataSet d = new DataSet( 2 );
    d.add( x1, y1 );
    d.add( x2, y2 );
    p.addDataSet( d, titulo, c, true, Chart.InterpolationType.INTERPOLATION_LINEAR, ancho, Chart.PointStyle.POINT_NONE );
}

// rectangulo relleno (barra o caja): se rellena con lineas verticales finas pegadas
void rect( Plot p, double x1, double x2, double y1, double y2, java.awt.Color c, boolean borde ) {
    int n = Math.max( 8, (int) ( ( x2 - x1 ) * 80 ) );
    for ( int i = 0; i <= n; i++ ) {
        double x = x1 + ( x2 - x1 ) * i / n;
        linea( p, x, y1, x, y2, c, 2, "" );
    }
    if ( borde ) {
        linea( p, x1, y1, x2, y1, TINTA, 1, "" );
        linea( p, x1, y2, x2, y2, TINTA, 1, "" );
        linea( p, x1, y1, x1, y2, TINTA, 1, "" );
        linea( p, x2, y1, x2, y2, TINTA, 1, "" );
    }
}

double techo( double v ) { return Math.ceil( Math.max( v, 100 ) * 1.15 / 50 ) * 50; }

// ================= Grafico del experimento Sensibilidad =================
// Grafico 3: tiempo medio (con banda IC 95%) vs. % de salidas bloqueadas
synchronized void dibujarSensibilidad() {
    plotSens.removeAll();
    DataSet med = new DataSet( 6 ), lo = new DataSet( 6 ), hi = new DataSet( 6 );
    double ymax = 0;
    for ( int k = 0; k <= 5; k++ ) {
        if ( nOk( k ) == 0 ) continue;
        double x = 100.0 * k / 6, m = media( k ), h = ic95( k );
        med.add( x, m );  lo.add( x, m - h );  hi.add( x, m + h );
        ymax = Math.max( ymax, m + h );
    }
    java.awt.Color azul = new java.awt.Color( 42, 120, 214 ), celeste = new java.awt.Color( 140, 175, 230 );
    plotSens.addDataSet( lo, "IC 95% inferior", celeste, true, Chart.InterpolationType.INTERPOLATION_LINEAR, 1, Chart.PointStyle.POINT_NONE );
    plotSens.addDataSet( hi, "IC 95% superior", celeste, true, Chart.InterpolationType.INTERPOLATION_LINEAR, 1, Chart.PointStyle.POINT_NONE );
    plotSens.addDataSet( med, "Media", azul, true, Chart.InterpolationType.INTERPOLATION_LINEAR, 2, Chart.PointStyle.POINT_CIRCLE );
    linea( plotSens, -5, 90, 88, 90, ROJO, 2, "Umbral 90 s" );
    plotSens.setFixedHorizontalScale( -5, 88 );
    plotSens.setFixedVerticalScale( 0, techo( ymax ) );
}]]></AdditionalClassCode>
