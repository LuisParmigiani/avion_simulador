				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788300000009</Id>
					<Name><![CDATA[rel]]></Name>
					<X>1050</X><Y>-190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return t < 0 ? -1 : t - tAmerizaje;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788300000010</Id>
					<Name><![CDATA[encabezadoCorrida]]></Name>
					<X>1050</X><Y>-160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String[] s = { "1L", "1R", "AlaFwdL", "AlaFwdR", "AlaAftL", "AlaAftR" };
StringBuilder sb = new StringBuilder( "completa;tEvacPax;tEvacTotal;cumple90" );
for ( String p : new String[]{ "pax_", "tUlt_", "tApe_", "tPri_" } )
    for ( String x : s ) sb.append( ';' ).append( p ).append( x );
return sb.toString();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788300000011</Id>
					<Name><![CDATA[filaCorrida]]></Name>
					<X>1050</X><Y>-130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[boolean ok = tEvacuacionTotal >= 0;   // termino: salieron los 192
StringBuilder sb = new StringBuilder();
sb.append( ok ? 1 : 0 ).append( ';' )
  .append( num( tEvacuacionPax ) ).append( ';' )
  .append( num( tEvacuacionTotal ) ).append( ';' )
  .append( ok && tEvacuacionTotal <= 90 ? 1 : 0 );   // 14 CFR 25.803(c): todos los ocupantes
for ( int i = 0; i < 6; i++ ) sb.append( ';' ).append( porSalida[ i ] );
for ( int i = 0; i < 6; i++ ) sb.append( ';' ).append( num( rel( tUltimaSalida[ i ] ) ) );
for ( int i = 0; i < 6; i++ ) sb.append( ';' ).append( num( rel( tApertura[ i ] ) ) );
for ( int i = 0; i < 6; i++ ) sb.append( ';' ).append( num( rel( tPrimeraSalida[ i ] ) ) );
return sb.toString();]]></Body>
				</Function>
			</Functions>

