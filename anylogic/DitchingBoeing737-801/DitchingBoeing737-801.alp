				<EmbeddedObject>
					<Id>1788003095222</Id>
					<Name><![CDATA[Sale]]></Name>
					<X>590</X><Y>-320</Y>
					<Label><X>-20</X><Y>-30</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.pedestrian]]></PackageName>
						<ClassName><![CDATA[PedSink]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.pedestrian]]></PackageName>
							<ClassName><![CDATA[PedSink]]></ClassName>
							<ItemName><![CDATA[1412464601104]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// la salida queda ocupada mientras este ocupante la cruza (caudal limitado)
tLibre[ ped.salidaIdx ] = time() + tiempoPaso( ped.salidaIdx );
enCamino[ ped.salidaIdx ]--;
int n = ped.llevaMenor ? 2 : 1;   // el adulto sale con el menor en brazos
porSalida[ ped.salidaIdx ] += n;
activos.remove( ped );
evacuados += n;

if ( tPrimeraSalida[ ped.salidaIdx ] < 0 ) tPrimeraSalida[ ped.salidaIdx ] = time();
tUltimaSalida[ ped.salidaIdx ] = time();

// la cabina quedo vacia de pasajeros: recien ahora sale la tripulacion
if ( evacuados == totalPax ) {
    tEvacuacionPax = time() - tAmerizaje;
    SentadoTrip.freeAll();
}

if ( evacuados == totalPax + 6 ) {
    tEvacuacionTotal = time() - tAmerizaje;
    reporteFinal();
    finishSimulation();   // Integrante 4: la corrida termina sola
}

// --- Instrumentacion (Integrante 4) ---
double tRel = time() - tAmerizaje;
for ( int k = 0; k < n; k++ ) {                  // todos los ocupantes (192)
    tiemposEvac.add( tRel );
    dsEvacuados.add( tRel, tiemposEvac.size() );
}
registroAgentes.add( ped.rol + ";" + nombreSalida( ped.salidaIdx ) + ";" + num( tRel ) + ";"
    + ped.edad + ";" + ped.esHombre + ";" + ped.esPMR + ";"
    + ped.llevaEquipaje + ";" + ped.llevaMenor );]]></Code>
							</Value>
						</Parameter>
					</Parameters>
					<ReplicationFlag>false</ReplicationFlag>
					<Replication Class="CodeValue">
						<Code><![CDATA[100]]></Code>
					</Replication>
