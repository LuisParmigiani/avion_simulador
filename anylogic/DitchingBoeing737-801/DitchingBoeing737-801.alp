				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788008550554</Id>
					<Name><![CDATA[distanciaSalida]]></Name>
					<X>460</X><Y>-70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[return Math.abs( p.getY() - posSalidaY( i ) )
     + Math.abs( p.getX() - posSalidaX( i ) );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1788008599363</Id>
					<Name><![CDATA[elegirSalida]]></Name>
					<X>460</X><Y>-40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[sabeBloqueos]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[int mejor = -1;
double mejorCosto = Double.POSITIVE_INFINITY;

for ( int i = 0; i < salidas.length; i++ ) {
    if ( sabeBloqueos && !salidaActiva[ i ] ) continue;
    double costo = distanciaSalida( p, i ) + pesoCongestion * gentEnCamino( p, i );
    if ( costo < mejorCosto ) { mejorCosto = costo; mejor = i; }
}
return mejor;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1788028294597</Id>
					<Name><![CDATA[gentEnCamino]]></Name>
					<X>600</X><Y>-70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[double y0 = Math.min( p.getY(), posSalidaY( i ) );
double y1 = Math.max( p.getY(), posSalidaY( i ) );
int n = 0;
for ( Pasajero q : activos )
    if ( q != p && q.getY() >= y0 && q.getY() <= y1 ) n++;
return n;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788030955066</Id>
					<Name><![CDATA[configurarEscenario]]></Name>
					<X>600</X><Y>-100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[switch ( escenario ) {
    case 1:  salidaActiva = new boolean[]{ true,  true,  true,  true,  true,  true  }; break;
    case 2:  salidaActiva = new boolean[]{ true,  false, false, true,  true,  false }; break;
    case 3:  salidaActiva = new boolean[]{ false, false, true,  true,  true,  false }; break;
    case 4:  salidaActiva = new boolean[]{ true,  false, true,  false, true,  false }; break;
    case 5: {   // Sensibilidad (Integrante 4): nBloqueadas salidas al azar
        salidaActiva = new boolean[ 6 ];
        java.util.Arrays.fill( salidaActiva, true );
        java.util.List<Integer> idx = new java.util.ArrayList<Integer>();
        for ( int i = 0; i < 6; i++ ) idx.add( i );
        java.util.Collections.shuffle( idx, getDefaultRandomGenerator() );
        for ( int j = 0; j < Math.min( nBloqueadas, 5 ); j++ ) salidaActiva[ idx.get( j ) ] = false;
        break;
    }
    default: salidaActiva = new boolean[]{ true,  true,  true,  true,  true,  true  };
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788030959087</Id>
					<Name><![CDATA[duracionApertura]]></Name>
					<X>600</X><Y>-130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// AnyLogic usa triangular(min, max, mode) pero corrige solo el orden si la
// moda cae fuera del intervalo, asi que se escribe ascendente como en el resto
// del modelo. Los 4 numeros son SUPUESTOS PROPIOS (ver DECISIONES.md 7).

// tipo I delanteras: las abre tripulacion entrenada, incluye inflado del tobogan
if ( i <= 1 ) return triangular( 8, 12, 20 );

// tipo III sobre el ala: la abre un pasajero sin entrenamiento y hay que
// retirar una escotilla de ~15 kg
return triangular( 20, 30, 45 );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792000000004</Id>
					<Name><![CDATA[tiempoPaso]]></Name>
					<X>730</X><Y>-130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// CAUDAL POR SALIDA: segundos que la salida i queda ocupada por cada ocupante que la cruza.
// Medias de Gobbin et al. (2021), Tabla 4 (tomadas de Liu et al., 2014):
// tipo I 0.780 pax/s (1.28 s/pax), tipo III 0.639 pax/s (1.56 s/pax).
// La dispersion (triangular, escrita ascendente como en duracionApertura) es supuesto propio.
if ( i <= 1 ) return triangular( 0.9, 1.2, 1.75 );   // media 1.28 s
return triangular( 1.1, 1.5, 2.1 );                  // media 1.57 s]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788030959088</Id>
					<Name><![CDATA[intentarAbrir]]></Name>
					<X>740</X><Y>-100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[if ( i < 0 || !salidaActiva[ i ] ) return;   // bloqueada en este escenario
if ( tApertura[ i ] >= 0 )         return;   // ya la esta abriendo alguien

// las tipo I delanteras solo las puede abrir la tripulacion
if ( i <= 1 && p.rol == RolPax.PASAJERO ) return;

tApertura[ i ] = time() + duracionApertura( i );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1788030959089</Id>
					<Name><![CDATA[salidaAbierta]]></Name>
					<X>730</X><Y>-70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[return i >= 0 && salidaActiva[ i ]
    && tApertura[ i ] >= 0 && time() >= tApertura[ i ];]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788036013617</Id>
					<Name><![CDATA[reporteFinal]]></Name>
					<X>700</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String[] nom  = { "1L", "1R", "AlaFwdL", "AlaFwdR", "AlaAftL", "AlaAftR" };
String[] tip  = { "I", "I", "III", "III", "III", "III" };
String[] desc = { "", "baseline: las 6 salidas",
                      "50% bloqueado, alternado",
                      "50% bloqueado, centrales sobre el ala",
                      "bloqueo asimetrico: un lado completo" };

traceln( "" );
traceln( "============================================================" );
traceln( "  RESUMEN DE LA CORRIDA" );
traceln( "------------------------------------------------------------" );
traceln( "  Escenario ......... %d  (%s)", escenario,
         escenario >= 1 && escenario <= 4 ? desc[ escenario ] : "sin definir" );
traceln( "  Iluminacion ....... x%.2f  (%s)", factorIluminacion,
         factorIluminacion >= 1.0 ? "plena luz" : "de emergencia" );
if ( hayObstaculo )
    traceln( "  Obstaculo pasillo . SI, %d valijas (x0.5 a menos de 0.5 m)", valijas.size() );
else
    traceln( "  Obstaculo pasillo . NO" );
traceln( "------------------------------------------------------------" );
traceln( "  SALIDA     TIPO  ESTADO       ABRIO   SALIERON    1ro   ULTIMO" );
for ( int i = 0; i < 6; i++ ) {
    String est = !salidaActiva[ i ] ? "BLOQUEADA"
               : ( tApertura[ i ] < 0 ? "sin abrir" : "abierta" );
    traceln( "  %-9s  %-4s  %-10s %6s  %8d %6s %8s",
        nom[ i ], tip[ i ], est,
        tApertura[ i ]     < 0 ? "-" : String.format( "%.1f", tApertura[ i ]     - tAmerizaje ),
        porSalida[ i ],
        tPrimeraSalida[ i ]< 0 ? "-" : String.format( "%.1f", tPrimeraSalida[ i ]- tAmerizaje ),
        tUltimaSalida[ i ] < 0 ? "-" : String.format( "%.1f", tUltimaSalida[ i ] - tAmerizaje ) );
}
traceln( "  (tiempos en segundos desde el amerizaje)" );
traceln( "------------------------------------------------------------" );
traceln( "  Pasajeros (%d) fuera en ..... %.1f s", totalPax, tEvacuacionPax );
traceln( "  Ocupantes (%d) fuera en ..... %.1f s", totalPax + 6, tEvacuacionTotal );
traceln( "  Cumple el umbral de 90 s .... %s", tEvacuacionTotal <= 90 ? "SI" : "NO" );
traceln( "============================================================" );]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788300000007</Id>
					<Name><![CDATA[nombreSalida]]></Name>
					<X>1050</X><Y>-250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[i]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if ( i < 0 || i > 5 ) return "-";
return new String[]{ "1L", "1R", "AlaFwdL", "AlaFwdR", "AlaAftL", "AlaAftR" }[ i ];]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1788300000008</Id>
					<Name><![CDATA[num]]></Name>
					<X>1050</X><Y>-220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[x]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
