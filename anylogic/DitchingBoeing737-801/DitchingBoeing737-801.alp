						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit5]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// la puerta estaba bloqueada: recien AHORA se entera y elige otra
int nueva = elegirSalida( ped, true );
if ( nueva >= 0 && nueva != ped.salidaIdx ) {
    enCamino[ ped.salidaIdx ]--;
    ped.salidaIdx = nueva;
    enCamino[ nueva ]++;
}]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[probability1]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[probability2]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[probability3]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[probability4]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[probability5]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[exitNumber]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[choiceIsVolatile]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// el primero que llega a una puerta cerrada se pone a abrirla
intentarAbrir( ped.salidaIdx, ped );]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit1]]></Name>
						</Parameter>
						<Parameter>
